# Choose one provider: openai | gemini | mock
# Code Studio requires openai or gemini plus the matching API key.
DEVPILOT_MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Data stays in this directory. Keep outside version control.
DEVPILOT_DATA_DIR=.devpilot-data

# Repository test/build commands execute untrusted project code. Leave false unless
# the app is running inside an OS/container sandbox with network disabled.
DEVPILOT_ENABLE_TEST_EXECUTION=false
DEVPILOT_TEST_TIMEOUT_MS=60000
DEVPILOT_MAX_REPOSITORY_BYTES=104857600
DEVPILOT_MAX_FILES=10000
